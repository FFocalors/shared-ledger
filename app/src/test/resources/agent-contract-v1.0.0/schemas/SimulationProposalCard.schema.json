          "title": "Expense Version",
          "type": "string",
          "x-database-type": "signed-bigint",
          "x-maximum": "9223372036854775807",
          "x-minimum": "1"
        },
        "financial_locked": {
          "title": "Financial Locked",
          "type": "boolean"
