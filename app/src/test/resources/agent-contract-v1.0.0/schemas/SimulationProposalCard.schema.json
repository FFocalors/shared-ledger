          "title": "Activity Financial Version",
          "type": "string",
          "x-database-type": "signed-bigint",
          "x-maximum": "9223372036854775807",
          "x-minimum": "0"
        },
        "after": {
          "$ref": "#/$defs/ExpenseSnapshot"
        },
        "before": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExpenseSnapshot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "changes": {
          "items": {
            "discriminator": {
              "mapping": {
                "base_amount": "#/$defs/ExpenseAmountChange",
                "fx_snapshot": "#/$defs/ExpenseFxChange",
                "icon_key": "#/$defs/ExpenseIconChange",
                "ledger_unit_id": "#/$defs/ExpenseLedgerUnitChange",
                "note": "#/$defs/ExpenseNoteChange",
                "occurred_at": "#/$defs/ExpenseOccurredAtChange",
                "original_amount": "#/$defs/ExpenseAmountChange",
                "original_currency": "#/$defs/ExpenseCurrencyChange",
                "payment_allocations": "#/$defs/ExpensePaymentsChange",
                "split": "#/$defs/ExpenseSplitChange",
                "title": "#/$defs/ExpenseTitleChange"
              },
              "propertyName": "field"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ExpenseTitleChange"
              },
              {
                "$ref": "#/$defs/ExpenseAmountChange"
              },
              {
                "$ref": "#/$defs/ExpenseCurrencyChange"
              },
              {
                "$ref": "#/$defs/ExpenseLedgerUnitChange"
              },
              {
                "$ref": "#/$defs/ExpensePaymentsChange"
              },
              {
                "$ref": "#/$defs/ExpenseSplitChange"
              },
              {
                "$ref": "#/$defs/ExpenseNoteChange"
              },
              {
                "$ref": "#/$defs/ExpenseOccurredAtChange"
              },
              {
                "$ref": "#/$defs/ExpenseIconChange"
              },
              {
                "$ref": "#/$defs/ExpenseFxChange"
              }
            ]
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Changes",
          "type": "array"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "kind": {
          "const": "expense",
          "title": "Kind",
          "type": "string"
        },
        "simulation": {
          "title": "Simulation",
          "type": "boolean"
        },
        "summary": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "summary",
        "after",
        "changes",
        "activity_financial_version",
        "generated_at",
        "simulation"
      ],
      "title": "ExpensePreview",
      "type": "object"
    },
    "ExpenseSnapshot": {
