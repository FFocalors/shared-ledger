  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "card_kind": {
      "const": "simulation_pending",
      "title": "Card Kind",
      "type": "string"
    },
    "confirmation_enabled": {
      "const": false,
