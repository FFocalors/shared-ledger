        "note": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "occurred_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occurred At"
        },
        "original_amount": {
          "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,4})?$",
          "title": "Original Amount",
          "type": "string"
        },
        "original_currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Original Currency",
          "type": "string"
        },
        "payment_allocations": {
          "items": {
            "$ref": "#/$defs/CanonicalPayment"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Payment Allocations",
          "type": "array"
        },
        "split": {
          "discriminator": {
            "mapping": {
              "equal": "#/$defs/CanonicalEqualSplit",
              "manual": "#/$defs/CanonicalManualSplit"
            },
            "propertyName": "mode"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CanonicalEqualSplit"
            },
            {
              "$ref": "#/$defs/CanonicalManualSplit"
            }
          ],
          "title": "Split"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "ledger_unit_id",
        "title",
        "original_amount",
        "original_currency",
        "base_amount",
        "payment_allocations",
        "split",
        "expense_version",
        "financial_locked"
      ],
      "title": "ExpenseSnapshot",
      "type": "object"
    },
