    {
      "type": "fifo_repayment",
      "ref": "transfer_1",
      "from_participant": "B",
      "to_participant": "A",
      "amount": "30.0",
      "currency": "CNY"
    },
    {
      "type": "fifo_repayment",
      "ref": "transfer_2",
      "from_participant": "B",
      "to_participant": "A",
      "amount": "20.0",
      "currency": "CNY"
    },
    {
      "type": "fifo_repayment",
      "ref": "transfer_3",
      "from_participant": "B",
      "to_participant": "A",
      "amount": "50.0",
      "currency": "CNY"
    }
  ]
