# Required. Relative paths resolve from this agent/ directory.
AGENT_STORAGE_PATH=./data/agent.sqlite3

# Bind locally by default. Use a deliberate host value only when needed.
AGENT_LISTEN_HOST=127.0.0.1
AGENT_LISTEN_PORT=8765

# Auth is fail-closed until both values are configured. The API key is the
# Supabase publishable/anon project key; it is never an end-user Bearer token.
# The service verifies each user token remotely at /auth/v1/user.
AGENT_SUPABASE_AUTH_BASE_URL=
AGENT_SUPABASE_API_KEY=

# Plain HTTP is rejected except for explicitly opted-in local loopback Auth.
AGENT_ALLOW_INSECURE_LOOPBACK_AUTH_HTTP=false

# Agent planning is a separate server-side gate from provider_mode. Both this
# gate and AGENT_PROVIDER_MODE=mock must be enabled to schedule local simulation.
# Mock planning reads fixtures and creates simulation-only previews; inference
# and business writes remain unavailable. Auth and current activity scope apply.
AGENT_AGENT_ENABLED=false
# Increment DISABLE_REVISION on every disable transition; keep its value when
# re-enabling and never roll it back. The config-backed gate does not persist it.
AGENT_DISABLE_REVISION=1

# Cursor MAC key: supply a stable random value of at least 32 UTF-8 bytes when
# cursors must survive process restart. Blank uses a process-local random key.
AGENT_CURSOR_SIGNING_SECRET=

# Bound inbound JSON and basic per-IP/per-actor request rate.
AGENT_MAX_REQUEST_BYTES=65536
AGENT_API_REQUESTS_PER_MINUTE=120

# Provider is explicitly opt-in. `disabled` keeps the health-only Runtime;
# `mock` enables the deterministic, offline P1-05 simulation Runtime.
AGENT_PROVIDER_MODE=disabled
# The Runtime has one model call in flight regardless of this fixed value.
AGENT_MODEL_CONCURRENCY=1
AGENT_RUNTIME_TASK_CONCURRENCY=4
AGENT_MOCK_MODEL_TIMEOUT_SECONDS=2.0
AGENT_RUNTIME_SHUTDOWN_TIMEOUT_SECONDS=2.0
