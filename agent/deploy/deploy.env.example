# Compose variables are always loaded from an explicit --env-file by scripts.
# Copy to deploy.env for local settings. Never commit deploy.env.
AGENT_HOST_PORT=8765

# Production-safe defaults. Mock mode is local simulation only and has no
# model inference or business write adapter.
AGENT_PROVIDER_MODE=disabled
AGENT_AGENT_ENABLED=false
AGENT_DISABLE_REVISION=1

# Leave blank until a real user-auth integration is deliberately configured.
AGENT_SUPABASE_AUTH_BASE_URL=
AGENT_SUPABASE_API_KEY=
AGENT_ALLOW_INSECURE_LOOPBACK_AUTH_HTTP=false
AGENT_CURSOR_SIGNING_SECRET=

AGENT_MAX_REQUEST_BYTES=65536
AGENT_API_REQUESTS_PER_MINUTE=120
