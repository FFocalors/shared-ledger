    "RequestReceipt": {
      "additionalProperties": false,
      "description": "Four-table placement is defined in the freeze document; response snapshots contain no nonce.",
      "properties": {
        "client_request_id": {
          "format": "uuid",
          "title": "Client Request Id",
          "type": "string"
        },
        "http_status": {
          "maximum": 599,
          "minimum": 200,
          "title": "Http Status",
          "type": "integer"
        },
        "key_scope": {
          "enum": [
            "sessions.create",
            "turns.submit",
            "turns.resume.clarification",
            "turns.resume.auth",
            "turns.resume.proposal_adjust",
            "turns.cancel",
            "proposals.confirm"
          ],
          "title": "ApiActionKind",
          "type": "string"
        },
        "owner_user_id": {
          "format": "uuid",
          "title": "Owner User Id",
          "type": "string"
        },
        "payload_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Payload Hash",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "resource_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Id"
        },
        "response_kind": {
          "enum": [
            "session_created",
            "turn_accepted",
            "turn_resumed",
            "proposal_adjusted",
            "turn_cancelled",
            "confirmation_unavailable"
          ],
          "title": "RequestReceiptKind",
          "type": "string"
        },
        "response_snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/CreateSessionResponse"
            },
            {
              "$ref": "#/$defs/SubmitTurnAccepted"
            },
            {
              "$ref": "#/$defs/TurnMutationAccepted"
            },
            {
              "$ref": "#/$defs/CancelTurnResponse"
            },
            {
              "$ref": "#/$defs/ProposalAdjustedAccepted"
            },
            {
              "$ref": "#/$defs/ConfirmationUnavailableResponse"
            }
          ],
          "title": "Response Snapshot"
        }
      },
      "required": [
        "key_scope",
        "owner_user_id",
        "client_request_id",
        "payload_hash",
        "http_status",
        "response_kind",
        "response_snapshot",
        "recorded_at"
      ],
      "title": "RequestReceipt",
      "type": "object"
    },
