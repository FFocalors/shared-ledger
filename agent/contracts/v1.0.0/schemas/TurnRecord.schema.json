    "TurnPublicStatus": {
      "additionalProperties": false,
      "description": "Client-visible state; owner identity and private bindings remain server-side.",
      "properties": {
        "context_version": {
          "minimum": 1,
          "title": "Context Version",
          "type": "integer"
        },
        "execution_assigned": {
          "title": "Execution Assigned",
          "type": "boolean"
        },
        "execution_resolution": {
          "anyOf": [
            {
              "enum": [
                "succeeded",
                "rejected",
                "closed",
                "unknown"
              ],
              "title": "ExecutionResolution",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Resolution"
        },
        "resume_state": {
          "anyOf": [
            {
              "enum": [
                "QUEUED",
                "RUNNING",
                "WAIT_CONFIRM",
                "EXECUTING",
                "RECOVERING"
              ],
              "title": "ResumeState",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
