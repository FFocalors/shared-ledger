  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Typed turn-row payload, including the append-only request receipts for resume replay.",
  "properties": {
    "bound_evidence_references": {
      "items": {
        "discriminator": {
          "mapping": {
            "activity": "#/$defs/BoundActivityEvidence",
            "debt": "#/$defs/BoundDebtEvidence",
            "expense": "#/$defs/BoundExpenseEvidence"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/BoundActivityEvidence"
          },
          {
            "$ref": "#/$defs/BoundExpenseEvidence"
          },
          {
            "$ref": "#/$defs/BoundDebtEvidence"
          }
        ]
      },
      "maxItems": 48,
      "title": "Bound Evidence References",
      "type": "array"
    },
    "bound_read_results": {
      "items": {
        "$ref": "#/$defs/BoundReadResultReference"
      },
      "maxItems": 16,
      "title": "Bound Read Results",
      "type": "array"
    },
    "bound_references": {
      "items": {
        "discriminator": {
          "mapping": {
            "activity": "#/$defs/BoundActivityReference",
            "expense": "#/$defs/BoundExpenseReference",
            "ledger_unit": "#/$defs/BoundLedgerUnitReference",
            "participant": "#/$defs/BoundParticipantReference"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/BoundActivityReference"
          },
          {
            "$ref": "#/$defs/BoundLedgerUnitReference"
          },
          {
            "$ref": "#/$defs/BoundExpenseReference"
          },
          {
            "$ref": "#/$defs/BoundParticipantReference"
          }
        ]
      },
      "maxItems": 64,
      "title": "Bound References",
      "type": "array"
    },
    "client_request_id": {
      "format": "uuid",
      "title": "Client Request Id",
      "type": "string"
    },
    "original_text": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Original Text",
      "type": "string"
    },
    "request_payload_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Payload Hash",
      "type": "string"
    },
    "request_receipts": {
      "items": {
        "$ref": "#/$defs/RequestReceipt"
      },
      "maxItems": 256,
      "title": "Request Receipts",
      "type": "array"
    },
    "turn": {
      "$ref": "#/$defs/TurnStateSnapshot"
    },
    "ui_context_snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/UIContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "turn",
    "client_request_id",
    "request_payload_hash",
    "original_text",
    "bound_references",
    "bound_evidence_references",
    "request_receipts"
  ],
  "title": "TurnRecord",
  "type": "object"
}
