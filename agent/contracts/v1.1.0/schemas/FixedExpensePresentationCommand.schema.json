{
  "$defs": {
    "CanonicalExpensePresentationPatch": {
      "additionalProperties": false,
      "properties": {
        "icon_key": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9_]{1,48}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Icon Key"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "title": "CanonicalExpensePresentationPatch",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activity_id": {
      "format": "uuid",
      "title": "Activity Id",
      "type": "string"
    },
    "expected_expense_version": {
      "pattern": "^(?:[1-9]|[1-9][0-9]{1}|[1-9][0-9]{2}|[1-9][0-9]{3}|[1-9][0-9]{4}|[1-9][0-9]{5}|[1-9][0-9]{6}|[1-9][0-9]{7}|[1-9][0-9]{8}|[1-9][0-9]{9}|[1-9][0-9]{10}|[1-9][0-9]{11}|[1-9][0-9]{12}|[1-9][0-9]{13}|[1-9][0-9]{14}|[1-9][0-9]{15}|[1-9][0-9]{16}|[1-9][0-9]{17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$",
      "title": "Expected Expense Version",
      "type": "string",
      "x-database-type": "signed-bigint",
      "x-maximum": "9223372036854775807",
      "x-minimum": "1"
    },
    "expense_id": {
      "format": "uuid",
      "title": "Expense Id",
      "type": "string"
    },
    "operation": {
      "const": "expense.presentation.update",
      "title": "Operation",
      "type": "string"
    },
    "patch": {
      "$ref": "#/$defs/CanonicalExpensePresentationPatch"
    }
  },
  "required": [
    "operation",
    "activity_id",
    "expense_id",
    "expected_expense_version",
    "patch"
  ],
  "title": "FixedExpensePresentationCommand",
  "type": "object"
}
