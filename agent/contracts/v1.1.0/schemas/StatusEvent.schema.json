{
  "$defs": {
    "StatusEventPayload": {
      "additionalProperties": false,
      "properties": {
        "resume_state": {
          "anyOf": [
            {
              "enum": [
                "QUEUED",
                "RUNNING",
                "WAIT_CONFIRM",
                "EXECUTING",
                "RECOVERING"
              ],
              "title": "ResumeState",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resume State"
        },
        "state": {
          "enum": [
            "QUEUED",
            "RUNNING",
            "WAIT_INPUT",
            "WAIT_CONFIRM",
            "EXECUTING",
            "RECOVERING",
            "COMPLETED",
            "CANCELLED",
            "FAILED"
          ],
          "title": "TurnState",
          "type": "string"
        },
        "state_revision": {
          "minimum": 1,
          "title": "State Revision",
          "type": "integer"
        },
        "step": {
          "enum": [
            "accepted",
            "build_context",
            "model_decision",
            "tool_read",
            "prepare_proposal",
            "awaiting_user",
            "auth_required",
            "dispatch",
            "reconcile",
            "finalize",
            "terminal"
          ],
          "title": "TurnStep",
          "type": "string"
        },
        "wait_reason": {
          "anyOf": [
            {
              "enum": [
                "missing_fields",
                "auth_required",
                "confirm_required",
                "execution_result_unknown"
              ],
              "title": "WaitReason",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wait Reason"
        }
      },
      "required": [
        "state",
        "step",
        "state_revision"
      ],
      "title": "StatusEventPayload",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/StatusEventPayload"
    },
    "seq": {
      "minimum": 1,
      "title": "Seq",
      "type": "integer"
    },
    "simulation": {
      "title": "Simulation",
      "type": "boolean"
    },
    "type": {
      "const": "status",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "type",
    "seq",
    "occurred_at",
    "simulation",
    "payload"
  ],
  "title": "StatusEvent",
  "type": "object"
}
