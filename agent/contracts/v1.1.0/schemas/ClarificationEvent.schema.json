      "type": "integer"
    },
    "simulation": {
      "title": "Simulation",
      "type": "boolean"
    },
    "type": {
      "const": "clarification",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "type",
    "seq",
    "occurred_at",
    "simulation",
    "payload"
  ],
  "title": "ClarificationEvent",
  "type": "object"
}
