          "title": "ResumeState",
          "type": "string"
        }
      },
      "required": [
        "prompt",
        "missing_slots",
        "resume_state"
      ],
      "title": "ClarificationEventPayload",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/ClarificationEventPayload"
    },
    "seq": {
      "minimum": 1,
