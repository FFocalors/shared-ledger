          "const": "expenses",
          "title": "Kind",
          "type": "string"
        },
        "participant_ref": {
          "anyOf": [
            {
              "enum": [
                "participant_selected",
                "participant_1",
                "participant_2",
                "participant_3",
                "participant_4",
                "participant_5",
                "participant_6",
                "participant_7",
                "participant_8",
                "participant_9",
                "participant_10",
                "participant_11",
                "participant_12",
                "participant_13",
