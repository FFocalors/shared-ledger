              "title": "ParticipantRef",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Participant Ref"
        },
        "to_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "To Date"
        }
      },
      "required": [
        "kind",
        "activity_ref"
      ],
      "title": "ReadExpensesCriteria",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "criteria": {
      "discriminator": {
        "mapping": {
          "activities": "#/$defs/ReadActivitiesCriteria",
          "debts": "#/$defs/ReadDebtsCriteria",
          "expenses": "#/$defs/ReadExpensesCriteria"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ReadActivitiesCriteria"
        },
        {
          "$ref": "#/$defs/ReadExpensesCriteria"
        },
        {
          "$ref": "#/$defs/ReadDebtsCriteria"
        }
      ],
      "title": "Criteria"
    },
    "kind": {
      "const": "read",
      "title": "Kind",
      "type": "string"
    },
    "operation": {
      "enum": [
        "read.activities",
        "read.expenses",
        "read.debts"
      ],
      "title": "ReadOperation",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "operation",
    "criteria"
  ],
  "title": "ReadDecision",
  "type": "object"
}
